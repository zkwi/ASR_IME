{
  "name": "voxtype-desktop",
  "version": "0.1.55",
  "description": "VoxType desktop speech input app built with Tauri, Rust, and Svelte",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "audit:npm": "npm audit --registry=https://registry.npmjs.org",
    "audit:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust-audit.ps1",
    "scan:secrets": "node scripts/scan-secrets.mjs --git-visible",
    "scan:secrets:staged": "node scripts/scan-secrets.mjs --staged",
    "test:secrets": "node scripts/test-scan-secrets.mjs",
    "ai:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-check.ps1",
    "ai:release-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-release-check.ps1",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.19.17",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.10"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
